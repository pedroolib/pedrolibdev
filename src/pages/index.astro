---
import '../styles.css';

const experience = [
  { year: '25-Now', name: 'Vanttec', tags: 'USV Perception Lead', id: 'project-1' },
  { year: '25', name: 'Botbusters', tags: 'FTC Robotics Mentor', id: null },
  { year: '23', name: 'UC San Diego', tags: 'Research Assistant', id: 'project-5' },
  { year: '22—24', name: 'Innobotics', tags: 'Software Lead & Captain', id: 'project-6' },
  { year: '16-22', name: 'Mexicali Robotics', tags: 'Software Lead & Captain', id: null }
];

const work = [
  {
    id: 'project-1',
    year: '25—Now',
    title: 'Autonomous USV — Autonomous perception and navigation for RoboBoat',
    what: 'Building the perception stack for an autonomous surface vehicle using ROS 2, computer vision, and sensor fusion.',
    impact: 'Building toward RoboBoat 2026, where the vehicle must autonomously perceive, navigate, and complete real-world maritime challenges.',
    stack: '[TODO: e.g. ROS 2, Python, OpenCV]',
    team: '[TODO: your role + collaborators]',
  },
  {
    id: 'project-2',
    year: '25—Now',
    title: 'Uribot — AI automation for small businesses',
    what: 'A multi-tenant AI platform that turns customer chats across WhatsApp, Instagram, and Messenger into qualified leads, quotes, and appointments—with a human handoff when needed.',
    impact: 'Grew from an automotive-workshop assistant into reusable SMB automation and has generated approximately US$1,500 to date.',
    stack: 'Python, Flask, OpenAI, PostgreSQL, Redis, Chatwoot, MinIO, Docker, Coolify, Traefik',
    team: 'Founder · Product & Software Engineering',
  },
  {
    id: 'project-3',
    year: '26',
    title: 'SentinelBox — Catching HVAC failures before they happen',
    what: 'A team-built predictive-maintenance system that learns each HVAC unit’s normal behavior and spots early signs of trouble using edge AI.',
    impact: 'Won 1st place at Carrier’s 2026 Keep It Cool Hackathon. In controlled prototype tests, SentinelBox reported a 6-second average detection time and 0% false alarms.',
    stack: 'ESP32, C/C++, UART, MPU6500, INA219, MAX6675, embedded neural network, Next.js, SQLite',
    team: 'A collaborative project by Eduardo Pérez, Pedro Uribe, Alejandro Chio, Emiliano Méndez, and Miguelangel Rodríguez.',
  },
  {
    id: 'project-4',
    year: '26',
    title: 'MiNorte — An AI financial team for small businesses',
    what: 'A HackMTY 2026 Banorte Challenge project that turns small-business banking and invoice data into grounded insights, generative dashboards, and useful next steps.',
    impact: 'Responded to the challenge to build real-time AI-generated financial interfaces with MCP, using a deterministic engine so the AI explains verified numbers instead of inventing them.',
    stack: 'Python, FastAPI, Next.js 14, TypeScript, Supabase/Postgres, OpenAI, MCP, Playwright',
    team: 'A collaborative HackMTY 2026 project: I focused on product logic and backend systems, while teammates implemented the frontend and Playwright ticket-automation flow.',
  },
  {
    id: 'project-5',
    year: '23',
    title: 'High-performance processor design for artificial intelligence — UCSD ENLACE',
    what: 'A real-time geometric shape classifier built at UC San Diego that pairs a linear SVM with 4-bit quantized weights designed with hardware implementation in mind.',
    impact: 'Held 98%+ accuracy after quantization, ran live from a webcam in Colab, and was presented at the ENLACE closing conference at UCSD and as an invited talk at the UCSD-ENLACE-México Symposium in Tijuana.',
    stack: 'Python, OpenCV, scikit-learn, NumPy, Matplotlib, Google Colab, Xilinx ZYNQ',
    team: 'UCSD ENLACE Summer Research 2023 · Vertically-integrated VLSI Information Processing Lab · Prof. Mingu Kang · Mentors Chang Eun Song, Zihan Xia, Ashkan Moradi · with Omar Dario Martinez Blackaller',
  },
  {
  id: 'project-6',
  year: '22—24',
  title: 'Innobotics FRC — Autonomous robotics and competition software',
  what: 'Led the development of robot software, autonomous routines, and PID and feedforward control systems for FRC Team 6694.',
    impact: 'Built competition-ready autonomous and control systems while serving as Software Lead and Team Captain.',
    stack: '[TODO: e.g. WPILib, Java, PID control]',
    team: '[TODO: your role + collaborators]',
  },
];

const playground = [
  {
    title: 'FPGA Controller — FPGA, UART, Digital Systems',
    desc: 'A custom hardware controller built on an FPGA to control the simulator through real-time UART communication.',
    img: '/playground/fpgacontroller/IMG_4947.JPG',
    imgW: 1200,
    imgH: 900,
    imgAlt: 'FPGA controller perfboard with seven-segment displays',
    video: '/playground/fpgacontroller/fpgacontrol.mp4',
    videoW: 1024,
    videoH: 576,
    videoAlt: 'Demo video: FPGA controller in action',
  },
  {
    title: 'Smart Tractor — Embedded Systems, RTOS, Computer Vision',
    desc: 'An STM32-based tractor controlled with Logitech pedals, with a Grafana dashboard and vision-based operator drowsiness detection.',
    poster: '/playground/smarttractor/poster.jpg',
    video: '/playground/smarttractor/VideoTractor.mp4',
    videoW: 640,
    videoH: 480,
    videoAlt: 'Demo video: STM32-based tractor driving while a Grafana dashboard shows live telemetry',
    repo: 'https://github.com/pedroolib/JohnDeere-RLTractorModelation',
  },
  {
    title: 'John Deere Simulator — Unity, C#',
    desc: 'A 2D farming simulator built in Unity to recreate and visualize tractor operation.',
    img: '/playground/JohnDeereSim/JohnDeereSim.jpg',
    imgW: 934,
    imgH: 523,
    imgAlt: 'JohnDeereSim pixel-art farming game screenshot',
  },
  {
    title: 'Minecraft Fishing AI Bot — Python, AI, Computer Vision',
    desc: 'An automated fishing bot that solves captchas and responds to staff messages using AI.',
    poster: '/playground/autofish/poster.jpg',
    video: '/playground/autofish/autofisher.mp4',
    videoW: 960,
    videoH: 720,
    videoAlt: 'Demo video: Minecraft fishing bot casting and reeling automatically',
    repo: 'https://github.com/pedroolib/Minecraft-Fishing-AIBot',
  },
];

const discs = [
  { src: '/red_disk.png', width: 129, height: 130, label: 'Play si preguntas por mi', pathId: 'circlePathRed', motto: 'You Are Going To Figure It Out. You Always Do •', trackId: '7z3rdMzhY122waIpkSsE7P', song: 'si preguntas por mi' },
  { src: '/green_disk.png', width: 129, height: 129, label: "Play Desenfocao'", pathId: 'circlePathGreen', motto: "Never Give Up On What You Can't Stop Thinking Of •", trackId: '2CEf2gU5ZJamLXa3NrgAvA', song: "Desenfocao'" },
  { src: '/white_disk.png', width: 129, height: 129, label: 'Play DIME QUIÉN????', pathId: 'circlePathWhite', motto: 'Keep Improving Yourself, Stop Trying To Prove It •', trackId: '1ImWmtI7DM2uFPNJHHbD8g', song: 'DIME QUIÉN????' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <link rel="preconnect" href="https://open.spotify.com" />
    <link rel="icon" type="image/gif" href="/favicon.gif" />
    <script is:inline>
      try {
        document.documentElement.dataset.theme =
          localStorage.getItem('pedrolibdev-theme') === 'light' ? 'light' : 'dark';
      } catch (e) {
        document.documentElement.dataset.theme = 'dark';
      }
    </script>
    <title>PedroLib</title>
    <meta
      name="description"
      content="[TODO: one-line portfolio description. Replace with your own title, location, and focus.]"
    />
  </head>
  <body class="bg-ink text-fg">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:bg-white focus:px-3 focus:py-2 focus:text-black"
    >
      Skip to content
    </a>

    <!-- Mobile mini nav -->
    <nav aria-label="Sections" class="site-nav sticky top-0 z-40 flex items-center justify-between border-b border-line px-4 py-2 backdrop-blur md:hidden">
      <span class="text-micro text-fg">Pedro Librado Uribe Reyes</span>
      <div class="flex gap-4 text-micro">
        <a class="text-muted hover:text-fg" href="#about">About</a>
        <a class="text-muted hover:text-fg" href="#projects">Projects</a>
        <a class="text-muted hover:text-fg" href="#playground">Playground</a>
      </div>
    </nav>

    <!-- Header -->
    <header class="grid grid-cols-1 gap-6 px-4 pb-6 pt-6 md:grid-cols-12 md:px-6">
      <div class="relative self-start md:col-span-4" id="contact-wrap">
        <h1 class="text-[16px] font-normal text-fg">Pedro Librado Uribe Reyes</h1>
        <button
          id="contact-toggle"
          class="mt-1 flex items-center gap-2 text-micro text-dim hover:text-fg"
          aria-expanded="false"
          aria-controls="contact-panel"
        >
          <span>libradouribe25@gmail.com</span>
          <span aria-hidden="true" class="contact-icon inline-block text-base leading-none">+</span>
        </button>
        <div id="contact-panel" class="absolute left-0 top-full z-40 hidden min-w-[10rem] flex-col gap-1 pt-2 text-micro" hidden>
          <a class="drop-link text-muted hover:text-fg" href="https://www.instagram.com/pedroo.lib/" target="_blank" rel="noopener" aria-label="Instagram">Instagram</a>
          <a class="drop-link text-muted hover:text-fg" href="mailto:libradouribe25@gmail.com" aria-label="Email">Email</a>
          <a class="drop-link text-muted hover:text-fg" href="https://x.com/pedroolib" target="_blank" rel="noopener" aria-label="X">X</a>
          <a class="drop-link text-muted hover:text-fg" href="#" aria-label="TODO resume link">Resume</a>
          <a class="drop-link text-muted hover:text-fg" href="https://www.linkedin.com/in/pedro-librado/" target="_blank" rel="noopener" aria-label="LinkedIn">LinkedIn</a>
        </div>
      </div>

      <div class="md:col-span-3">
        <p class="text-[16px] text-fg">Robotics, AI & Software Engineer</p>
        <p class="text-micro text-dim">Monterrey, Nuevo León, México</p>
      </div>

      <div class="md:col-span-5">
        <h2 class="sr-only">Experience index</h2>
        <dl class="space-y-1 text-micro">
          {experience.map((item) => (
            <div class="tabular grid grid-cols-[2.75rem_1fr] gap-x-3 break-words md:grid-cols-[3.5rem_minmax(0,1fr)_minmax(0,1fr)]">
              <dt class="sr-only">{item.name} year</dt>
              <dd class="text-dim">{item.year}</dd>
              <dd>
                {item.id ? (
                  <button
                    class="open-modal text-left text-fg hover:underline"
                    data-modal={item.id}
                  >
                    {item.name} <span aria-hidden="true">▸</span>
                  </button>
                ) : (
                  <span class="text-left text-fg">{item.name}</span>
                )}
              </dd>
              <dd class="col-start-2 text-dim md:col-start-3">{item.tags}</dd>
            </div>
          ))}
        </dl>
        <div class="mt-4 grid grid-cols-[auto_1fr] gap-x-4 text-micro">
          <span class="text-dim">Skills</span>
          <span class="text-muted">Python, C++, Java, ROS 2, Embedded Systems, IoT, Edge AI, Computer Vision, DevOps, Docker, Linux, NVIDIA Jetson, STM32, Full-Stack Development</span>
        </div>
      </div>
    </header>

    <!-- Vinyl hero -->
    <section aria-label="Intro" class="relative flex min-h-[38vh] flex-wrap items-center justify-center gap-10 px-4 py-10 md:min-h-[46vh] md:gap-14 md:px-6">
      {discs.map((disc) => (
        <button
          type="button"
          class="disc-btn relative h-52 w-52 md:h-64 md:w-64"
          data-track={disc.trackId}
          data-title={disc.song}
          aria-pressed="false"
          aria-label={disc.label}
        >
          <svg viewBox="0 0 200 200" class="vinyl-ring-text absolute inset-0 h-full w-full" aria-hidden="true">
            <defs>
              <path id={disc.pathId} d="M 100,100 m -78,0 a 78,78 0 1,1 156,0 a 78,78 0 1,1 -156,0" />
            </defs>
            <text class="fill-dim" style="font-size: 10.5px; letter-spacing: 2.5px; font-family: 'Monocraft', monospace;">
              <textPath href={`#${disc.pathId}`}>{disc.motto}</textPath>
            </text>
          </svg>
          <div class="absolute left-1/2 top-1/2 w-3/5 -translate-x-1/2 -translate-y-1/2">
            <img
              src={disc.src}
              width={disc.width}
              height={disc.height}
              alt=""
              aria-hidden="true"
              loading="eager"
              class="vinyl-spin h-auto w-full"
              style="image-rendering: pixelated;"
            />
          </div>
        </button>
      ))}
      <p class="sr-only">[TODO: replace circular tagline with your own line.]</p>
    </section>

    <!-- Main 3 columns -->
    <main id="main" class="grid grid-cols-1 gap-10 px-4 pb-10 md:grid-cols-3 md:gap-6 md:px-6">
      <!-- About -->
      <div class="col-stack" data-col="about">
      <section id="about" aria-labelledby="about-heading" class="about-sec scroll-mt-16 min-w-0">
        <h2 id="about-heading" class="mb-3 text-[16px] font-normal text-dim">About</h2>

        <div class="about-blur">
        <div class="about-group">
        <div class="about-photo relative border border-line bg-paper">
          <div class="about-photo-img relative aspect-[4/5] overflow-hidden">
            <img
              class="slide-img"
              src="/about/1/IMG_2086.jpg"
              width="954"
              height="1200"
              alt="Selfie at home"
              loading="eager"
              decoding="async"
              data-cap="[TODO caption]"
            />
            <img
              class="slide-img"
              src="/about/1/IMG_2520.JPG"
              width="900"
              height="1200"
              alt="Holding a champion plaque on a soccer field at night"
              loading="lazy"
              decoding="async"
              hidden
              data-cap="[TODO caption: e.g. talk, workshop, demo]"
            />
            <img
              class="slide-img"
              src="/about/1/IMG_9126.jpeg"
              width="900"
              height="1200"
              alt="Concert crowd"
              loading="lazy"
              decoding="async"
              hidden
              data-cap="[TODO caption: e.g. portrait, process, sketch]"
            />
          </div>
          <button
            class="about-next-btn absolute inset-0 h-full w-full cursor-pointer"
            type="button"
            aria-label="Next photo"
          >
            <span aria-hidden="true" class="about-next-float">Next &gt;</span>
          </button>
        </div>

        <div class="about-texts mt-8 space-y-5 text-micro">
          <p><strong class="font-bold text-fg">Background</strong> <span class="text-dim">—</span> <span class="text-muted">I grew up in Mexicali, Mexico, and I've been building things for as long as I can remember. Robotics competitions introduced me to engineering early on and shaped the way I work today: learn by building, break things, fix them, and keep improving.</span></p>
          <p><strong class="font-bold text-fg">Focus</strong> <span class="text-dim">—</span> <span class="text-muted">I enjoy designing systems where hardware, software, and people come together to solve real problems. I work across robotics, AI, embedded systems, and software, with a strong focus on efficiency and on building things that can actually be used to improve everyday life.</span></p>
          <p><strong class="font-bold text-fg">Concerns</strong> <span class="text-dim">—</span> <span class="text-muted">I believe technology should make things simpler and more efficient, not add complexity for its own sake. I care about building things that go beyond a prototype and become genuinely useful.</span></p>
          <p><strong class="font-bold text-fg">Approach</strong> <span class="text-dim">—</span> <span class="text-muted">I'm a very social person and I genuinely enjoy working with people. That's also why I've naturally gravitated toward leadership. I like bringing people together, listening to different ideas, helping others grow, and creating an environment where we push each other to do better. At the end of the day, I enjoy building great things, but I enjoy even more building them with great people.</span></p>
        </div>
        </div>

        <div class="about-photo relative mt-8 border border-line bg-paper">
          <div class="about-photo-img relative aspect-[4/5] overflow-hidden">
            <img
              class="slide-img"
              src="/about/2/BC7CE8C4-D92A-4F55-8059-18EC3E153B7C.jpeg"
              width="952"
              height="1090"
              alt="Sitting on the snow with a snowboard"
              loading="lazy"
              decoding="async"
              data-cap="[TODO caption]"
            />
            <img
              class="slide-img"
              src="/about/2/7B26EE6D-1E75-4D57-87D4-447E8253B3F2.JPG"
              width="901"
              height="1200"
              alt="Selfie at a Rauw Alejandro concert"
              loading="lazy"
              decoding="async"
              hidden
              data-cap="[TODO caption]"
            />
          </div>
          <button
            class="about-next-btn absolute inset-0 h-full w-full cursor-pointer"
            type="button"
            aria-label="Next photo"
          >
            <span aria-hidden="true" class="about-next-float">Next &gt;</span>
          </button>
        </div>

        <div class="about-texts mt-8 space-y-5 text-micro">
          <h3 class="font-bold text-fg">About Me</h3>
          <p class="text-muted">When I'm not building something, I really enjoy being around people. Spending time with my friends and my girlfriend, going out, watching sports together, or just having a good conversation is a big part of who I am.</p>
          <p class="text-muted">Sports are also a huge part of my life. I'm a Barça, Kansas City Chiefs, and Dodgers fan, and I love playing flag football whenever I get the chance. I'm pretty competitive, so I definitely get more invested in games than I probably should.</p>
          <p class="text-muted">I've also been playing video games for as long as I can remember, especially Minecraft. I've been playing since version 1.7 and somehow never really stopped, which is also where the inspiration for this website came from.</p>
          <p class="text-muted">And there's almost always music playing in the background. I listen to a lot of reggaeton, with Rauw Alejandro being my favorite artist. Overall, I just enjoy having fun, being around the people I care about, trying new things, and making good memories along the way.</p>
        </div>
        </div>
      </section>
      </div>

      <!-- Projects -->
      <div class="col-stack" data-col="work">
      <section id="projects" aria-labelledby="projects-heading" class="projects-sec scroll-mt-16 min-w-0">
        <h2 id="projects-heading" class="mb-3 text-[16px] font-normal text-dim">Projects</h2>
        <div class="space-y-8">
          {work.map((item, i) => (
            <article class="work-card group" aria-labelledby={`${item.id}-title`}>
              <button
                class="open-modal block w-full text-left"
                data-modal={item.id}
                aria-haspopup="dialog"
              >
                {item.id === 'project-3' ? (
                  <img
                    class="work-thumb aspect-video w-full border border-line object-cover"
                    src="/projects/sentinelbox/team.webp"
                    width="900"
                    height="506"
                    alt="SentinelBox team celebrating its first-place hackathon result"
                    loading="lazy"
                    decoding="async"
                  />
                ) : item.id === 'project-2' ? (
                  <div class="work-thumb flex aspect-video items-center justify-center border border-line bg-[#111318] p-6 text-center">
                    <span class="text-micro text-muted">[PHOTO SUGGESTION · CONVERSATION TO BOOKING]<br /><span class="text-dim">An anonymized customer chat, quote, and appointment flow</span></span>
                  </div>
                ) : item.id === 'project-4' ? (
                  <img
                    class="work-thumb aspect-[16/10] w-full border border-line object-cover"
                    src="/projects/minorte/MiNorteLogo.png"
                    width="1680"
                    height="945"
                    alt="MiNorte logo on a light background"
                    loading="lazy"
                    decoding="async"
                  />
                ) : item.id === 'project-5' ? (
                  <img
                    class="work-thumb aspect-[4/3] w-full border border-line object-cover"
                    src="/projects/ShapeDetection/WhatsApp Image 2026-10-07 at 9.41.04 AM (7).jpeg"
                    width="1200"
                    height="900"
                    alt="Closing presentation at UC San Diego — Jacobs School of Engineering, Electrical and Computer Engineering"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="work-thumb flex aspect-[4/3] items-center justify-center border border-line bg-[#111318] p-6 text-center">
                    <span class="text-micro text-muted">[TODO work image {String(i + 1).padStart(2, '0')}]<br /><span class="text-dim">replace with real project still</span></span>
                  </div>
                )}
                <p class="mt-2 text-micro text-muted">
                  <span id={`${item.id}-title`} class="work-title text-fg">{item.title}</span>
                  <span class="float-right text-dim">{item.year}</span>
                </p>
              </button>
              <p class="mt-1 hidden text-micro text-dim md:block">{item.what}</p>
            </article>
          ))}
        </div>
      </section>
      </div>

      <!-- Playground -->
      <div class="col-stack" data-col="playground">
      <section id="playground" aria-labelledby="playground-heading" class="playground-sec scroll-mt-16 min-w-0">
        <h2 id="playground-heading" class="mb-3 text-[16px] font-normal text-dim">Playground</h2>
        <div class="space-y-8">
          {playground.map((item) => {
            const Card = item.repo ? 'a' : 'div';
            const cardLink = item.repo
              ? {
                  href: item.repo,
                  target: '_blank',
                  rel: 'noopener noreferrer',
                  'aria-label': `${item.title} — opens repository on GitHub`,
                }
              : {};
            return (
              <article class="work-card">
                <Card class="block" {...cardLink}>
                  {item.video ? (
                    <div class="about-photo relative aspect-[4/3] w-full overflow-hidden border border-line">
                      <div class="about-photo-img absolute inset-0">
                        <video
                          class="slide-img"
                          src={item.video}
                          poster={item.poster || item.img}
                          width={item.videoW}
                          height={item.videoH}
                          autoplay
                          muted
                          loop
                          playsinline
                          aria-label={item.videoAlt}
                        ></video>
                        {item.img && (
                          <img
                            class="slide-img"
                            src={item.img}
                            width={item.imgW}
                            height={item.imgH}
                            alt={item.imgAlt}
                            loading="lazy"
                            decoding="async"
                            hidden
                          />
                        )}
                      </div>
                      {item.img && (
                        <button
                          class="about-next-btn absolute inset-0 h-full w-full cursor-pointer"
                          type="button"
                          aria-label="Next demo view"
                        >
                          <span aria-hidden="true" class="about-next-float">Next &gt;</span>
                        </button>
                      )}
                      {item.repo && (
                        <span aria-hidden="true" class="repo-float">↗ Repo</span>
                      )}
                    </div>
                  ) : item.img ? (
                    <img
                      class="work-thumb aspect-[4/3] w-full border border-line object-cover"
                      src={item.img}
                      width={item.imgW}
                      height={item.imgH}
                      alt={item.imgAlt}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <div class="work-thumb flex aspect-[4/3] items-center justify-center border border-line bg-[#0e0f13] p-6 text-center" role="img" aria-label="TODO playground image placeholder">
                      <span class="text-micro text-muted">[TODO playground visual]</span>
                    </div>
                  )}
                  <p class="work-title mt-2 text-micro text-fg">{item.title}</p>
                  <p class="mt-1 text-micro text-dim">{item.desc}</p>
                </Card>
              </article>
            );
          })}
        </div>
      </section>
      </div>
    </main>

    <!-- Case-study side panel -->
    {work.map((item) => (
      <dialog id={`modal-${item.id}`} aria-labelledby={`${item.id}-modal-title`} class="m-0 ml-auto flex h-[100dvh] max-h-[100dvh] w-[min(46rem,94vw)] max-w-none flex-col overflow-hidden border-0 border-l-2 border-line bg-ink p-0 text-fg">
        <div class="flex flex-none items-center justify-between gap-3 border-b border-line px-4 py-2">
          <p id={`${item.id}-modal-title`} class="text-micro">{item.title} — {item.year}</p>
          <button class="close-modal flex-none rounded-full border border-line px-3 py-1 text-micro text-muted hover:text-fg" data-close={item.id} type="button">Close</button>
        </div>
