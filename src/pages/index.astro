---
import '../styles.css';
import Image from '../components/Image.astro';
import aboutSelfieHome from '../assets/about/selfie-home.jpg';
import aboutChampionPlaque from '../assets/about/champion-plaque.jpg';
import aboutConcertCrowd from '../assets/about/concert-crowd.jpg';
import aboutConcertSelfie from '../assets/about/concert-selfie.jpg';
import aboutSnowboardSnow from '../assets/about/snowboard-snow.jpg';
import discRed from '../assets/discs/red-disk.png';
import discGreen from '../assets/discs/green-disk.png';
import discWhite from '../assets/discs/white-disk.png';
import lampOff from '../assets/lamps/redstone-lamp-off.png';
import lampOn from '../assets/lamps/redstone-lamp-on.png';
import fpgaControllerImg from '../assets/playground/fpgacontroller.jpg';
import johnDeereImg from '../assets/playground/johndeere-sim.jpg';
import senTeam from '../assets/projects/sentinelbox/team.webp';
import senDevice from '../assets/projects/sentinelbox/device-rooftop.webp';
import senElectronics from '../assets/projects/sentinelbox/electronics.webp';
import senDashboard from '../assets/projects/sentinelbox/dashboard.webp';
import senTwin from '../assets/projects/sentinelbox/3d-twin.webp';
import minorteLogo from '../assets/projects/minorte/minorte-logo.png';
import minorteDashboard from '../assets/projects/minorte/dashboard2.webp';
import minorteArch from '../assets/projects/minorte/architecture.webp';
import uribotQuote from '../assets/projects/uribot/conversation-quote.png';
import uribotBanner from '../assets/projects/uribot/uribot-banner.png';
import innoField from '../assets/projects/innobotics/field-speaker-6694.jpeg';
import innoCelebration from '../assets/projects/innobotics/celebration-flag.jpeg';
import innoPit from '../assets/projects/innobotics/pit-crew.jpeg';
import innoTeam from '../assets/projects/innobotics/full-team-hermosillo.jpeg';
import innoSpirit from '../assets/projects/innobotics/spirit-award.jpeg';
import innoDrive from '../assets/projects/innobotics/drive-station.jpeg';
import shapeStage from '../assets/projects/shapedetection/stage-title.jpeg';
import shapeZynq from '../assets/projects/shapedetection/zynq-board.jpeg';
import shapeTeam from '../assets/projects/shapedetection/team-lab.jpeg';
import shapeCert from '../assets/projects/shapedetection/olivia-graeve-cert.jpeg';
import vantPits from '../assets/projects/vanttec/team-pits-selfie.jpeg';
import vantLake from '../assets/projects/vanttec/lake-gates.jpeg';
import vantCart from '../assets/projects/vanttec/crew-cart.jpeg';
import vantPool from '../assets/projects/vanttec/pool-test.jpeg';
import vantElectronics from '../assets/projects/vanttec/electronics-bay.jpeg';


const experience = [
  { year: '25—Now', name: 'VantTec', tags: 'USV Perception Lead', id: 'project-1' },
  { year: '26', name: 'SMALC', tags: 'Robotics Education Volunteer', id: null },
  { year: '25', name: 'Botbusters', tags: 'FTC Robotics Mentor', id: null },
  { year: '23', name: 'UC San Diego', tags: 'Research Assistant', id: 'project-5' },
  { year: '22—25', name: 'Innobotics', tags: 'Software Lead & Captain', id: 'project-6' },
  { year: '16—22', name: 'Mexicali Robotics', tags: 'Software Lead & Captain', id: null }
];

const work = [
  {
    id: 'project-1',
    year: '25—Now',
    title: 'VantTec USV Perception — Perception stack for RoboBoat',
    what: 'Rebuilt the ROS 2 perception stack of an autonomous surface vehicle after its stereo camera failed. Trained its YOLO buoy dataset and set up its XBee telemetry and remote terminal access.',
    impact: 'Brought back the object ranges that the old pipeline stopped publishing, and made the boat testable in the field over radio links. I am bringing it to RoboBoat 2027.',
    stack: 'ROS 2 Humble, Python, C++, OpenCV, NumPy, TensorRT, ONNX, YOLO, Velodyne VLP-16, Gazebo Harmonic, rosbag2, Docker, NVIDIA Jetson, XBee telemetry, systemd, Git',
    team: 'USV Perception Lead on the VantTec student robotics team.',
  },
  {
    id: 'project-3',
    year: '26',
    title: 'SentinelBox — Catching HVAC failures before they happen',
    what: 'Team-built predictive maintenance for HVAC units: an ESP32 gateway learns how each unit normally runs and spots early trouble with an on-device neural network.',
    impact: 'Won 1st place at the 2026 Carrier Keep It Cool Hackathon. In controlled prototype tests, the team measured a 6-second average detection time and 0% false alarms.',
    stack: 'ESP32, C/C++, UART, MPU6500, INA219, MAX6675, embedded neural network, Next.js, SQLite',
    team: 'A team project by Eduardo Pérez, Pedro Uribe, Alejandro Chio, Emiliano Méndez, and Miguelangel Rodríguez.',
  },
  {
    id: 'project-2',
    year: '25—Now',
    title: 'Uribot — AI automation for small businesses',
    what: 'A multi-tenant AI platform that turns customer chats on WhatsApp, Instagram, and Messenger into qualified leads, quotes, and appointments, with a human handoff when needed.',
    impact: 'Started as an assistant for one automotive workshop and grew into reusable automation for small businesses. Revenue to date: approximately US$1,500.',
    stack: 'Python, Flask, OpenAI, PostgreSQL, Redis, Chatwoot, MinIO, Docker, Coolify, Traefik',
    team: 'Founder · Product & Software Engineering',
  },
  {
    id: 'project-5',
    year: '23',
    title: 'High-performance processor design for artificial intelligence — UCSD ENLACE',
    what: 'A real-time shape classifier built at UC San Diego. It uses a linear SVM with its weights quantized to 4-bit integers, with a hardware version in mind.',
    impact: 'Kept 98%+ accuracy after quantization and ran live from a webcam in Colab. I presented it at the ENLACE closing conference at UCSD and in an invited talk at the UCSD-ENLACE-México Symposium in Tijuana.',
    stack: 'Python, OpenCV, scikit-learn, NumPy, Matplotlib, Google Colab, Xilinx ZYNQ',
    team: 'UCSD ENLACE Summer Research 2023 · Vertically-integrated VLSI Information Processing Lab · Prof. Mingu Kang · Mentors Chang Eun Song, Zihan Xia, Ashkan Moradi · with Omar Dario Martinez Blackaller',
  },
  {
    id: 'project-6',
    year: '22—25',
    title: 'Innobotics FRC 6694 — Competition robotics software and leadership',
    what: 'Three seasons with FRC Team 6694 in Mexicali, Monterrey, and Hermosillo. I started in mechanics, became captain, then led the robot code, autonomous routines, and PID and feedforward control.',
    impact: '3rd place and the Spirit Award at Hermosillo 2024. 5th place and the Imagery Award at Monterrey 2023. All of it came from long build seasons with a fully student-run team.',
    stack: 'Java, WPILib, PID + feedforward control, NetworkTables, Gradle',
    team: 'FRC Team 6694 Innobotics · Software Lead & Captain · Feb 2022 – Jan 2025',
  },
  {
    id: 'project-4',
    year: '26',
    title: 'MiNorte — An AI financial team for small businesses',
    what: 'A HackMTY 2026 Banorte Challenge project that turns small-business bank and invoice data into insights with evidence, a generated weekly dashboard, and next steps.',
    impact: 'Answered the challenge brief: financial interfaces that AI generates in real time, built on MCP. A deterministic engine calculates every number, and the AI only explains it.',
    stack: 'Python, FastAPI, Next.js 14, TypeScript, Supabase/Postgres, OpenAI, MCP, Playwright',
    team: 'A HackMTY 2026 team project. I worked on the product logic, the backend systems and part of the frontend. My teammates built the rest of the frontend and the Playwright ticket-automation flow.',
  },
];

const playground = [
  {
    title: 'Smart Tractor — Embedded Systems, RTOS, Computer Vision',
    desc: 'An STM32 tractor that you drive with Logitech pedals. FreeRTOS tasks run a Simulink engine and transmission model every 40 ms, show the gear on an LCD and send telemetry to Grafana. If commands stop arriving, the tractor brakes by itself. Computer vision detects when the operator gets drowsy.',
    poster: '/playground/smarttractor/poster.jpg',
    video: '/playground/smarttractor/VideoTractor.mp4',
    videoW: 640,
    videoH: 480,
    videoAlt: 'Demo video: STM32-based tractor driving while a Grafana dashboard shows live telemetry',
    repo: 'https://github.com/pedroolib/JohnDeere-RLTractorModelation',
  },
  {
    title: 'Football Sim RL — Multi-Agent RL, PPO, Python',
    desc: 'A deterministic 2D football simulator. The quarterback, receivers, cornerbacks and pass rusher each learn their role with PPO and behavior cloning. Over 100 test drives, the learned quarterback scored a touchdown on 30% of drives, against 21% for the rule-based one.',
    poster: '/playground/footballsim/poster.jpg',
    video: '/playground/footballsim/demo.mp4',
    videoW: 1280,
    videoH: 720,
    videoAlt: 'Demo video: six parallel plays in the football simulator with a quarterback, two receivers, two cornerbacks and a pass rusher',
    repo: 'https://github.com/pedroolib/football-sim-rl',
  },
  {
    title: 'FPGA Controller — FPGA, UART, Digital Systems',
    desc: 'A handheld controller with seven-segment displays that runs on an FPGA. It controls the John Deere simulator in real time over UART.',
    img: fpgaControllerImg,
    poster: fpgaControllerImg.src,
    imgW: 1200,
    imgH: 900,
    imgAlt: 'FPGA controller perfboard with seven-segment displays',
    video: '/playground/fpgacontroller/fpgacontrol.mp4',
    videoW: 1024,
    videoH: 576,
    videoAlt: 'Demo video: FPGA controller in action',
  },
  {
    title: 'Minecraft Fishing AI Bot — Python, AI, Computer Vision',
    desc: 'An automated fishing bot that solves captchas and responds to staff messages using AI.',
    poster: '/playground/autofish/poster.jpg',
    video: '/playground/autofish/autofisher.mp4',
    videoW: 960,
    videoH: 720,
    videoAlt: 'Demo video: Minecraft fishing bot casting and reeling automatically',
    repo: 'https://github.com/pedroolib/Minecraft-Fishing-AIBot',
  },
  {
    title: 'John Deere Simulator — Unity, C#',
    desc: 'A 2D pixel-art farming simulator in Unity that shows how a tractor operates in the field.',
    img: johnDeereImg,
    imgW: 934,
    imgH: 523,
    imgAlt: 'JohnDeereSim pixel-art farming game screenshot',
  },
];

const discs = [
  { src: discRed, width: 129, height: 130, label: 'Play si preguntas por mi', pathId: 'circlePathRed', motto: 'You Are Going To Figure It Out. You Always Do •', trackId: '7z3rdMzhY122waIpkSsE7P', song: 'si preguntas por mi' },
  { src: discGreen, width: 129, height: 129, label: "Play Desenfocao'", pathId: 'circlePathGreen', motto: "Never Give Up On What You Can't Stop Thinking Of •", trackId: '2CEf2gU5ZJamLXa3NrgAvA', song: "Desenfocao'" },
  { src: discWhite, width: 129, height: 129, label: 'Play DIME QUIÉN????', pathId: 'circlePathWhite', motto: 'Keep Improving Yourself, Stop Trying To Prove It •', trackId: '1ImWmtI7DM2uFPNJHHbD8g', song: 'DIME QUIÉN????' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <link rel="preconnect" href="https://open.spotify.com" />
    <link rel="icon" type="image/gif" href="/favicon.gif" />
    <script is:inline>
      try {
        document.documentElement.dataset.theme =
          localStorage.getItem('pedrolibdev-theme') === 'light' ? 'light' : 'dark';
      } catch (e) {
        document.documentElement.dataset.theme = 'dark';
      }
    </script>
    <title>Pedro Librado Uribe Reyes — B.S. Robotics &amp; Digital Systems Student @ Tec de Monterrey</title>
    <meta
      name="description"
      content="Robotics and Digital Systems student at Tec de Monterrey building intelligent systems across robotics, embedded systems, and software. Turning ideas into autonomous machines, edge AI, and products that ship."
    />
    <link rel="canonical" href="https://pedrolib.dev/" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://pedrolib.dev/" />
    <meta property="og:title" content="Pedro Librado Uribe Reyes — B.S. Robotics & Digital Systems Student @ Tec de Monterrey" />
    <meta property="og:description" content="Robotics and Digital Systems student at Tec de Monterrey building intelligent systems across robotics, embedded systems, and software. Turning ideas into autonomous machines, edge AI, and products that ship." />
    <meta property="og:image" content="https://pedrolib.dev/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Pedro Librado Uribe Reyes — B.S. Robotics and Digital Systems Student at Tec de Monterrey — pedrolib.dev" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Pedro Librado Uribe Reyes — B.S. Robotics & Digital Systems Student @ Tec de Monterrey" />
    <meta name="twitter:description" content="Robotics and Digital Systems student at Tec de Monterrey building intelligent systems across robotics, embedded systems, and software. Turning ideas into autonomous machines, edge AI, and products that ship." />
    <meta name="twitter:image" content="https://pedrolib.dev/og-image.png" />
  </head>
  <body class="bg-ink text-fg">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:bg-white focus:px-3 focus:py-2 focus:text-black"
    >
      Skip to content
    </a>

    <div id="scroll-progress" aria-hidden="true"><div id="scroll-progress-fill"></div></div>

    <!-- Mobile mini nav -->
    <nav aria-label="Sections" class="site-nav sticky top-0 z-40 flex items-center justify-between border-b border-line px-4 py-2 backdrop-blur md:hidden">
      <span id="nav-name" class="text-micro text-fg" aria-hidden="true">Pedro Librado Uribe Reyes</span>
      <div class="flex gap-4 text-micro">
        <a class="-my-1 py-1 text-muted" href="#projects">Projects</a>
        <a class="-my-1 py-1 text-muted" href="#about">About</a>
        <a class="-my-1 py-1 text-muted" href="#playground">Playground</a>
      </div>
    </nav>

    <!-- Header -->
    <header class="grid grid-cols-1 gap-6 px-4 pb-6 pt-6 md:grid-cols-3 md:px-6">
      <div class="relative self-start" id="contact-wrap">
        <h1 class="text-[16px] font-normal text-fg">Pedro Librado Uribe Reyes</h1>
        <div id="contact-row" class="mt-1 -mb-1 flex items-center gap-1 text-micro">
          <a class="py-1 text-dim hover:text-fg" href="mailto:libradouribe25@gmail.com">libradouribe25@gmail.com</a>
          <button
            id="contact-toggle"
            class="flex min-w-6 items-center justify-center py-1 text-dim hover:text-fg"
            aria-expanded="false"
            aria-controls="contact-panel"
            aria-label="More contact links"
          >
            <span aria-hidden="true" class="contact-icon inline-block text-base leading-none">+</span>
          </button>
        </div>
        <div id="contact-panel" class="absolute left-0 top-full z-40 hidden min-w-[10rem] flex-col gap-1 pt-2 text-micro" hidden>
          <a class="drop-link text-muted hover:text-fg" href="https://www.instagram.com/pedroo.lib/" target="_blank" rel="noopener" aria-label="Instagram">Instagram</a>
          <a class="drop-link text-muted hover:text-fg" href="mailto:libradouribe25@gmail.com" aria-label="Email">Email</a>
          <a class="drop-link text-muted hover:text-fg" href="https://x.com/pedroolib" target="_blank" rel="noopener" aria-label="X">X</a>
          <a class="drop-link text-muted hover:text-fg" href="/Pedro_Uribe_Resume.pdf" target="_blank" rel="noopener" aria-label="Resume (PDF)">Resume</a>
          <a class="drop-link text-muted hover:text-fg" href="https://github.com/pedroolib" target="_blank" rel="noopener" aria-label="GitHub">GitHub</a>
          <a class="drop-link text-muted hover:text-fg" href="https://www.linkedin.com/in/pedro-librado/" target="_blank" rel="noopener" aria-label="LinkedIn">LinkedIn</a>
        </div>
      </div>

      <div>
        <p class="text-[16px] text-fg">B.S. Robotics &amp; Digital Systems Student @ Tec de Monterrey</p>
        <p class="text-micro text-dim">Monterrey, Nuevo León, México</p>
        <p class="mt-2 max-w-[42ch] text-micro text-muted">Looking for an internship or research stay in robotics, brain-computer interfaces, or AI hardware. Graduating June 2028.</p>
        <p class="mt-2 flex flex-wrap gap-x-4 text-micro">
          <a class="-my-1 py-1 text-fg underline underline-offset-4 hover:text-muted" href="/Pedro_Uribe_Resume.pdf" target="_blank" rel="noopener">Resume</a>
          <a class="-my-1 py-1 text-fg underline underline-offset-4 hover:text-muted" href="https://github.com/pedroolib" target="_blank" rel="noopener">GitHub</a>
          <a class="-my-1 py-1 text-fg underline underline-offset-4 hover:text-muted" href="https://www.linkedin.com/in/pedro-librado/" target="_blank" rel="noopener">LinkedIn</a>
        </p>
      </div>

      <div>
        <h2 class="sr-only">Experience index</h2>
        <dl class="grid grid-cols-[3.5rem_1fr] gap-x-3 gap-y-1 text-micro min-[1400px]:grid-cols-[3.5rem_auto_minmax(0,1fr)]">
          {experience.map((item) => (
            <div class="tabular contents">
              <dt class="sr-only">{item.name} year</dt>
              <dd class="text-dim">{item.year}</dd>
              <dd>
                {item.id ? (
                  <button
                    class="open-modal -my-1 py-1 text-left text-fg hover:underline"
                    data-modal={item.id}
                  >
                    {item.name} <span aria-hidden="true">▸</span>
                  </button>
                ) : (
                  <span class="text-left text-fg">{item.name}</span>
                )}
              </dd>
              <dd class="col-start-2 break-words text-dim min-[1400px]:col-start-3 min-[1400px]:text-right">{item.tags}</dd>
            </div>
          ))}
        </dl>
        <div class="mt-4 grid grid-cols-[auto_1fr] gap-x-4 text-micro">
          <span class="text-dim">Skills</span>
          <span class="text-muted">Python, C/C++, Java, TypeScript, ROS 2, PyTorch, YOLO, TensorRT, CUDA, OpenCV, LiDAR-camera fusion, NVIDIA Jetson, STM32, ESP32, FreeRTOS, FPGA (VHDL, Verilog), Docker, Linux, FastAPI, PostgreSQL</span>
        </div>
      </div>
    </header>

    <!-- Vinyl hero -->
    <section aria-label="Intro" class="relative flex min-h-[38vh] flex-wrap items-center justify-center gap-[4vw] px-4 py-10 md:min-h-[46vh] md:px-6 lg:gap-14">
      {discs.map((disc) => (
        <button
          type="button"
          class="disc-btn relative aspect-square w-[min(13rem,26vw)] md:w-[min(16rem,26vw)]"
          data-track={disc.trackId}
          data-title={disc.song}
          aria-pressed="false"
          aria-label={disc.label}
        >
          <svg viewBox="0 0 200 200" class="vinyl-ring-text absolute inset-0 h-full w-full" aria-hidden="true">
            <defs>
              <path id={disc.pathId} d="M 100,100 m -78,0 a 78,78 0 1,1 156,0 a 78,78 0 1,1 -156,0" />
            </defs>
            <text class="fill-dim" style="font-size: 10.5px; letter-spacing: 2.5px; font-family: 'Monocraft', monospace;">
              <textPath href={`#${disc.pathId}`}>{disc.motto}</textPath>
            </text>
          </svg>
          <div class="absolute left-1/2 top-1/2 w-3/5 -translate-x-1/2 -translate-y-1/2">
            <Image
              src={disc.src}
              width={disc.width}
              height={disc.height}
              alt=""
              aria-hidden="true"
              loading="eager"
              class="vinyl-spin h-auto w-full"
              style="image-rendering: pixelated;"
            />
          </div>
        </button>
      ))}
    </section>

    <!-- Main 3 columns -->
    <main id="main" class="grid grid-cols-1 gap-10 px-4 pb-10 md:grid-cols-3 md:gap-6 md:px-6">
      <!-- About -->
      <div class="col-stack" data-col="about">
        <h2 id="about-heading" class="col-heading text-[16px] font-normal text-dim">About</h2>
        <div class="col-body">
      <section id="about" aria-labelledby="about-heading" class="about-sec scroll-mt-16 min-w-0">

        <div class="about-blur">
        <div class="about-group">
        <div class="about-photo relative border border-line bg-paper">
          <div class="about-photo-img relative aspect-[4/5] overflow-hidden">
            <Image
              class="slide-img"
              src={vantPits}
              width="1280"
              height="960"
              alt="Group selfie of the VantTec team in black team shirts around the white twin-hull robot boat in the competition pits"
              loading="lazy"
              decoding="async"
            />
            <Image
              class="slide-img"
              src={aboutSelfieHome}
              width="954"
              height="1200"
              alt="Selfie at home"
              loading="lazy"
              decoding="async"
              hidden
            />
            <Image
              class="slide-img"
              src={aboutChampionPlaque}
              width="900"
              height="1200"
              alt="Holding a champion plaque on a soccer field at night"
              loading="lazy"
              decoding="async"
              hidden
            />
            <Image
              class="slide-img"
              src={aboutConcertCrowd}
              width="900"
              height="1200"
              alt="Concert crowd"
              loading="lazy"
              decoding="async"
              hidden
            />
          </div>
          <button
            class="about-next-btn absolute inset-0 h-full w-full cursor-pointer"
            type="button"
            aria-label="Next photo"
          >
            <span aria-hidden="true" class="about-next-float">Next &gt;</span>
          </button>
        </div>

        <div class="about-texts mt-8 space-y-5 text-micro">
          <p><strong class="font-bold text-fg">Background</strong> <span class="text-dim">—</span> <span class="text-muted">I grew up in Mexicali, Mexico, and I've been building things since I was a kid. Robotics competitions got me into engineering early, and they still shape how I work: build it, break it, fix it, and try again.</span></p>
          <p><strong class="font-bold text-fg">Focus</strong> <span class="text-dim">—</span> <span class="text-muted">I like designing systems where the hardware and software have to work for the people using them. I work across robotics, AI, embedded systems and software, and I care most about efficiency and about building things people can use every day.</span></p>
          <p><strong class="font-bold text-fg">Concerns</strong> <span class="text-dim">—</span> <span class="text-muted">Technology should make things simpler and more efficient. Extra complexity has a cost, so I only add it when it pays for itself. I also want what I build to get past the prototype stage and actually get used.</span></p>
          <p><strong class="font-bold text-fg">Approach</strong> <span class="text-dim">—</span> <span class="text-muted">I'm a social person and I like working with people, which is probably why I keep ending up in leadership roles. I like bringing a team together, hearing out different ideas, helping people grow, and building a group where we push each other. I enjoy building good things, and I enjoy it more when I build them with good people.</span></p>
        </div>
        </div>

        <div class="about-photo relative mt-8 border border-line bg-paper">
          <div class="about-photo-img relative aspect-[4/5] overflow-hidden">
            <Image
              class="slide-img"
              src={aboutSnowboardSnow}
              width="952"
              height="1090"
              alt="Sitting on the snow with a snowboard"
              loading="lazy"
              decoding="async"
            />
            <Image
              class="slide-img"
              src={aboutConcertSelfie}
              width="901"
              height="1200"
              alt="Selfie at a Rauw Alejandro concert"
              loading="lazy"
              decoding="async"
              hidden
            />
          </div>
          <button
            class="about-next-btn absolute inset-0 h-full w-full cursor-pointer"
            type="button"
            aria-label="Next photo"
          >
            <span aria-hidden="true" class="about-next-float">Next &gt;</span>
          </button>
        </div>

        <div class="about-texts mt-8 space-y-5 text-micro">
          <h3 class="font-bold text-fg">About Me</h3>
          <p class="text-muted">Outside of building things, I'm with friends, playing flag football, or watching Barça, the Chiefs or the Dodgers. There's almost always reggaeton on, usually Rauw Alejandro.</p>
          <p class="text-muted">I've played Minecraft since version 1.7, and that's where the look of this website comes from.</p>
        </div>
        </div>
      </section>
        </div>
      </div>

      <!-- Projects -->
      <!-- Projects come first on phones, so the work shows before the personal column. -->
      <div class="col-stack order-first md:order-none" data-col="work">
