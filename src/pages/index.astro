<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <link rel="preconnect" href="https://open.spotify.com" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='15' fill='black' stroke='%23333'/%3E%3Ccircle cx='16' cy='16' r='9' fill='none' stroke='%23333'/%3E%3Ccircle cx='16' cy='16' r='3' fill='black' stroke='%23666'/%3E%3C/svg%3E" />
    <script is:inline>
      try {
        document.documentElement.dataset.theme =
          localStorage.getItem('pedrolibdev-theme') === 'light' ? 'light' : 'dark';
      } catch (e) {
        document.documentElement.dataset.theme = 'dark';
      }
    </script>
    <title>Pedro Librado Uribe Reyes — Designer, Developer &amp; Prototyper</title>
    <meta
      name="description"
      content="[TODO: one-line portfolio description. Replace with your own title, location, and focus.]"
    />
  </head>
  <body class="bg-ink text-fg">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:bg-white focus:px-3 focus:py-2 focus:text-black"
    >
      Skip to content
    </a>

    <!-- Mobile mini nav -->
    <nav aria-label="Sections" class="site-nav sticky top-0 z-40 flex items-center justify-between border-b border-line px-4 py-2 backdrop-blur md:hidden">
      <span class="text-micro text-fg">Pedro Librado Uribe Reyes</span>
      <div class="flex gap-4 text-micro">
        <a class="text-muted hover:text-fg" href="#about">About</a>
        <a class="text-muted hover:text-fg" href="#work">Work</a>
        <a class="text-muted hover:text-fg" href="#playground">Playground</a>
      </div>
    </nav>

    <!-- Header -->
    <header class="grid grid-cols-1 gap-6 px-4 pb-6 pt-6 md:grid-cols-12 md:px-6">
      <div class="relative self-start md:col-span-4" id="contact-wrap">
        <h1 class="text-[16px] font-normal text-fg">Pedro Librado Uribe Reyes</h1>
        <button
          id="contact-toggle"
          class="mt-1 flex items-center gap-2 text-micro text-dim hover:text-fg"
          aria-expanded="false"
          aria-controls="contact-panel"
        >
          <span>libradouribe25@gmail.com</span>
          <span aria-hidden="true" class="contact-icon inline-block text-base leading-none">+</span>
        </button>
        <div id="contact-panel" class="absolute left-0 top-full z-40 hidden min-w-[10rem] flex-col gap-1 pt-2 text-micro" hidden>
          <a class="drop-link text-muted hover:text-fg" href="#" aria-label="TODO Instagram link">Instagram</a>
          <a class="drop-link text-muted hover:text-fg" href="#" aria-label="TODO Email link">Email</a>
          <a class="drop-link text-muted hover:text-fg" href="#" aria-label="TODO social link">Twitter / X</a>
          <a class="drop-link text-muted hover:text-fg" href="#" aria-label="TODO resume link">Resume</a>
          <a class="drop-link text-muted hover:text-fg" href="#" aria-label="TODO LinkedIn link">LinkedIn</a>
          <a class="drop-link text-muted hover:text-fg" href="#" aria-label="TODO Calendly link">Calendly</a>
