        >
          <svg viewBox="0 0 200 200" class="vinyl-ring-text absolute inset-0 h-full w-full" aria-hidden="true">
            <defs>
              <path id={disc.pathId} d="M 100,100 m -78,0 a 78,78 0 1,1 156,0 a 78,78 0 1,1 -156,0" />
