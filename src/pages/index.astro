      function markPressed(id) {
        discBtns.forEach((b) => {
          b.setAttribute('aria-pressed', b.getAttribute('data-track') === id ? 'true' : 'false');
        });
      }
      // Load the Spotify IFrame API on the first disc click, not on every visit.
      let spotifyScriptAdded = false;
      function loadSpotifyApi() {
        if (spotifyScriptAdded) return;
        spotifyScriptAdded = true;
        const s = document.createElement('script');
        s.src = 'https://open.spotify.com/embed/iframe-api/v1';
        s.async = true;
        document.head.appendChild(s);
      }
      function playTrack(id, title) {
        currentTrackId = id;
        markPressed(id);
        loadSpotifyApi();
        if (spotifyReady && spotifyController) {
          spotifyController.loadUri(`spotify:track:${id}`);
          spotifyController.play();
          showPill(title);
        } else {
          pendingTrack = { id, title };
          showPill(`${title} — loading…`);
          window.setTimeout(() => {
            if (pendingTrack && !spotifyReady) {
              showPillFallback(pendingTrack.id, pendingTrack.title);
              pendingTrack = null;
            }
          }, 8000);
        }
      }
      function stopPlayback() {
        try {
          if (spotifyController) spotifyController.pause();
        } catch {
          /* player unavailable — just hide UI */
        }
        currentTrackId = null;
        pendingTrack = null;
        markPressed('');
        hidePill();
      }

      window.onSpotifyIframeApiReady = (IFrameAPI) => {
        const mount = document.createElement('div');
        playerHost?.appendChild(mount);
        IFrameAPI.createController(
          mount,
          { width: '2', height: '2', uri: 'spotify:track:7z3rdMzhY122waIpkSsE7P' },
          (controller) => {
            spotifyController = controller;
            spotifyReady = true;
            window.__jukeboxApiReady = true;
            if (pendingTrack) {
              controller.loadUri(`spotify:track:${pendingTrack.id}`);
              controller.play();
              showPill(pendingTrack.title);
              pendingTrack = null;
            }
          }
        );
      };

      discBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-track') || '';
          const title = btn.getAttribute('data-title') || 'Unknown track';
          if (currentTrackId === id) stopPlayback();
          else playTrack(id, title);
        });
      });
      document.getElementById('jukebox-stop')?.addEventListener('click', stopPlayback);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && currentTrackId && !document.querySelector('dialog[open]')) {
          stopPlayback();
        }
      });

      // Theme lamp: dark by default, light swaps netherite <-> iron blocks.
      const themeBtn = document.getElementById('theme-toggle');
      function setTheme(mode) {
        const light = mode === 'light';
        document.documentElement.dataset.theme = light ? 'light' : 'dark';
        try {
          localStorage.setItem('pedrolibdev-theme', light ? 'light' : 'dark');
        } catch {
          /* private mode — theme just won't persist */
        }
        themeBtn?.setAttribute('aria-pressed', String(light));
        themeBtn?.setAttribute('aria-label', light ? 'Switch to dark mode' : 'Switch to light mode');
      }
      themeBtn?.addEventListener('click', () => {
        setTheme(document.documentElement.dataset.theme === 'light' ? 'dark' : 'light');
      });
      setTheme(document.documentElement.dataset.theme === 'light' ? 'light' : 'dark');

      // About photo: Next pill follows the cursor (delegated, clone-safe).
      // Scroll re-anchors it since the photo moves under a still cursor.
      let hoverPhoto = null;
      let lastCursor = null;
      function placePill(zone) {
        if (!lastCursor) return;
        const r = zone.getBoundingClientRect();
        zone.style.setProperty('--mx', `${lastCursor.x - r.left}px`);
        zone.style.setProperty('--my', `${lastCursor.y - r.top}px`);
      }
      document.addEventListener('pointermove', (e) => {
        if (!(e.target instanceof Element)) return;
        lastCursor = { x: e.clientX, y: e.clientY };
        const zone = e.target.closest('.about-photo');
        if (zone) {
          placePill(zone);
          if (hoverPhoto !== zone) {
            if (hoverPhoto instanceof HTMLElement) hoverPhoto.classList.remove('is-hover');
            zone.classList.add('is-hover');
            hoverPhoto = zone;
          }
        } else if (hoverPhoto instanceof HTMLElement) {
          hoverPhoto.classList.remove('is-hover');
          hoverPhoto = null;
        }
      });
      window.addEventListener(
        'scroll',
        () => {
          if (hoverPhoto instanceof HTMLElement) placePill(hoverPhoto);
        },
        { passive: true, capture: true }
      );

      // No autoplayed demo videos for reduced-motion users.
      if (REDUCED_MOTION) {
        document.querySelectorAll('video[autoplay]').forEach((v) => {
          v.removeAttribute('autoplay');
          v.pause();
        });
      }

      // Demo videos play only while their card is hovered/focused, and pause
      // on leave. Reduced-motion users stay paused. Touch screens play a
      // video only when it is tapped (see the click handler).
      if (!REDUCED_MOTION) {
        const cardVideos = Array.from(document.querySelectorAll('.work-card video'));
        if (window.matchMedia('(hover: hover)').matches) {
          cardVideos.forEach((v) => {
            const card = v.closest('.work-card');
            if (!(card instanceof HTMLElement)) return;
            const syncPlayback = () => syncDemoVideoPlayback(v, card);
            card.addEventListener('mouseenter', syncPlayback);
            card.addEventListener('mouseleave', syncPlayback);
            card.addEventListener('focusin', syncPlayback);
            card.addEventListener('focusout', syncPlayback);
          });
        }
      }

      // Touch screens: show "Tap to play" while a visible demo video is paused.
      if (IS_TOUCH) {
        document.querySelectorAll('.work-card video').forEach((v) => {
          const zone = v.closest('.about-photo');
          const sync = () => zone?.classList.toggle('is-playing', !v.paused && !v.hidden);
          v.addEventListener('play', sync);
          v.addEventListener('pause', sync);
        });
      }

      // Scroll reveal: images and paragraphs fade up when seen, fade back
      // after scrolling ~one card past them, so seeing them again replays
      // the same slow animation. Skipped for reduced-motion users.
      // Two observers give real hysteresis: entry fires on the normal
      // viewport line, exit fires only ~one card beyond the viewport.
      // (A single observer can't do this — it only fires at the crossing
      // moment when distance is ~0, so a distance check there never passes.)
      const revealSupported = !REDUCED_MOTION && 'IntersectionObserver' in window;
      const revealEnterObserver = revealSupported
        ? new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) entry.target.classList.add('in');
              });
            },
              // threshold 0 so small titles and tall About paragraphs trigger
              // on the same viewport line, not on a percentage of their own
              // height which made titles fire earlier. Bottom margin is 0 so
              // end-of-page content can still trigger: with a negative bottom
              // margin the last descriptions sit in the excluded zone at max
              // scroll and stay stuck invisible.
              { rootMargin: '0px 0px 0px 0px', threshold: 0 }
          )
        : null;
      const revealExitObserver = revealSupported
        ? new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) entry.target.classList.remove('in');
              });
            },
            // Expanded root: stays intersecting until ~350px (~one card)
            // past the viewport edge, then hides so a return visit replays.
            { rootMargin: '350px 0px 350px 0px', threshold: 0 }
          )
        : null;
      function watchReveals(root) {
        if (!revealEnterObserver || !revealExitObserver) return;
        const els = Array.from(
          (root || document).querySelectorAll(
            '.work-card .work-thumb, .work-card .about-photo, .work-card p, .about-photo, .about-texts p, .about-texts h3'
          )
        ).filter(
          (el) =>
            !el.classList.contains('in') &&
            !el.classList.contains('reveal') &&
            el.getClientRects().length > 0
        );
        // First paint the hidden state, then start observing. Without the
        // reflow, elements already in the viewport get .reveal + .in in the
        // same frame and skip the slow transition (fast flash).
        els.forEach((el) => el.classList.add('reveal'));
        if (els.length) void document.body.offsetHeight;
        els.forEach((el) => {
          revealEnterObserver.observe(el);
          revealExitObserver.observe(el);
        });
      }
      watchReveals(document);

      // Scroll progress bar: fixed bar at the very top fills left-to-right
      // as the page scrolls. No dependencies, works with reduced motion.
      const progressFill = document.getElementById('scroll-progress-fill');
      let progressTicking = false;
      function updateProgress() {
        progressTicking = false;
        if (!progressFill) return;
        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
        const progress = scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 0;
        progressFill.style.transform = `scaleX(${progress})`;
      }
      function scheduleProgress() {
        if (!progressTicking) {
          progressTicking = true;
          window.requestAnimationFrame(updateProgress);
        }
      }
      window.addEventListener('scroll', scheduleProgress, { passive: true });
      window.addEventListener('resize', scheduleProgress);
      window.addEventListener('load', updateProgress);
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(updateProgress);
      updateProgress();

      // Scroll-spy: highlight the mobile nav link for the section in view.
      // Position-based (not IntersectionObserver): the active link is always
      // the deepest section whose top sits above a probe line at 40% viewport
      // height. Recomputed every scroll so it can never stick on a section
      // you already left, and the last link holds at the page end.
      const spyLinks = Array.from(document.querySelectorAll('.site-nav a[href^="#"]'));
      const spySections = spyLinks
        .map((a) => document.querySelector(a.getAttribute('href') || ''))
        .filter((el) => el instanceof HTMLElement);
      function setActiveSpy(id) {
        spyLinks.forEach((a) => {
          const active = a.getAttribute('href') === `#${id}`;
          a.classList.toggle('active', active);
          if (active) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        });
      }
      let spyTicking = false;
      function updateSpy() {
        spyTicking = false;
        if (!spySections.length || !spySections[0]) return;
        const probe = window.scrollY + window.innerHeight * 0.4;
        let current = spySections[0];
        spySections.forEach((s) => {
          if (s instanceof HTMLElement && s.getBoundingClientRect().top + window.scrollY <= probe) {
            current = s;
          }
        });
        if (current instanceof HTMLElement) setActiveSpy(current.id);
      }
      function scheduleSpy() {
        if (!spyTicking) {
          spyTicking = true;
          window.requestAnimationFrame(updateSpy);
        }
      }
      window.addEventListener('scroll', scheduleSpy, { passive: true });
      window.addEventListener('resize', scheduleSpy);
      window.addEventListener('load', updateSpy);
      updateSpy();

      // Uniform synchronized columns: each column body drifts at its own
      // velocity, proportional to its length, so all columns run out of
      // content at the same point and the page stops right at the content.
      // The longest column (Projects) moves naturally — i.e. fastest — while
      // shorter columns lag behind by exactly their length difference, so
      // tops start aligned and bottoms end aligned. Kicks in only after the
      // section titles scroll out of view; before that offset stays 0.
      // Desktop + motion only; transforms live on .col-body so headings stay
      // put and reveal transforms on children are untouched.
      const parallaxMedia = window.matchMedia('(min-width: 768px)');
      const parallaxBodies = Array.from(
        document.querySelectorAll('.col-stack > .col-body')
      ).filter((el) => el instanceof HTMLElement);
      const parallaxHeading = document.querySelector(
        '.col-stack[data-col="work"] > .col-heading'
      );
      let parallaxFrame = 0;
      function headingsExitScrollY() {
        if (!(parallaxHeading instanceof HTMLElement)) return 0;
        const rect = parallaxHeading.getBoundingClientRect();
        return rect.top + window.scrollY + rect.height;
      }
      function updateParallax() {
        parallaxFrame = 0;
        const disable = !parallaxMedia.matches || REDUCED_MOTION;
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        const exitY = headingsExitScrollY();
        if (disable || maxScroll <= 0 || maxScroll <= exitY) {
          parallaxBodies.forEach((body) => {
            body.style.transform = '';
          });
          return;
        }
        if (window.scrollY <= exitY) {
          parallaxBodies.forEach((body) => {
            body.style.transform = '';
          });
          return;
        }
        // Re-measure live: fonts and late images shift body heights.
        const travels = parallaxBodies.map((body) =>
          Math.max(0, body.offsetHeight - window.innerHeight)
        );
        const maxTravel = Math.max(0, ...travels);
        const progress = Math.min(1, Math.max(0, (window.scrollY - exitY) / (maxScroll - exitY)));
        parallaxBodies.forEach((body, k) => {
          const offset = progress * (maxTravel - travels[k]);
          body.style.transform = offset
            ? `translate3d(0, ${offset.toFixed(1)}px, 0)`
            : '';
        });
      }
      function scheduleParallax() {
        if (!parallaxFrame) parallaxFrame = window.requestAnimationFrame(updateParallax);
      }
      window.addEventListener('scroll', scheduleParallax, { passive: true });
      window.addEventListener('resize', scheduleParallax);
      window.addEventListener('load', updateParallax);
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(updateParallax);
      if (parallaxMedia.addEventListener) {
        parallaxMedia.addEventListener('change', updateParallax);
      }
      updateParallax();

      // Eased wheel scrolling (desktop, motion allowed). Lenis sets the scroll
      // position from JS each frame and we move the columns in the same frame,
      // so all three columns stay in lockstep instead of the native-scrolled
      // one running a frame ahead of the transformed ones.
      let lenis = null;
      function syncSmoothScroll() {
        const want = parallaxMedia.matches && !REDUCED_MOTION;
        if (want && !lenis) {
          lenis = new Lenis({
            autoRaf: true,
            lerp: 0.1,
            // Let side-panel dialogs scroll natively.
            prevent: (node) => !!node.closest?.('dialog'),
          });
          lenis.on('scroll', updateParallax);
        } else if (!want && lenis) {
          lenis.destroy();
          lenis = null;
        }
      }
      syncSmoothScroll();
      if (parallaxMedia.addEventListener) {
        parallaxMedia.addEventListener('change', syncSmoothScroll);
      }

    </script>
  </body>
</html>
