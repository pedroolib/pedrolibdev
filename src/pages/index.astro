                <p class="mt-3 text-dim">Stack: <span class="text-muted">{item.stack}</span></p>
              </div>

              <div>
                <h3 class="mb-2 font-bold text-fg">Team</h3>
                <p class="text-muted">{item.team}</p>
              </div>

              <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                <div>
                  <h3 class="mb-2 font-bold text-fg">Key challenges</h3>
                  <ul class="list-disc space-y-1 pl-5 text-muted">
                    <li>[TODO: what problem were you solving?]</li>
                    <li>[TODO: what constraint shaped the work?]</li>
                    <li>[TODO: what was hard or unknown?]</li>
                  </ul>
                </div>
                <div>
                  <h3 class="mb-2 font-bold text-fg">Approach</h3>
                  <ul class="list-disc space-y-1 pl-5 text-muted">
                    <li>[TODO: how you tackled it]</li>
                    <li>[TODO: how you tested or iterated]</li>
                  </ul>
                </div>
              </div>

              <p class="pb-2 text-dim">[TODO: links, demo, repo, or video. Omit anything you cannot verify.]</p>
            </>
          )}
        </div>
      </dialog>
    ))}

    <!-- Theme lamp: redstone lamp, off in dark mode, glowing on in light mode -->
    <button
      id="theme-toggle"
      type="button"
      class="lamp-btn"
      aria-pressed="false"
      aria-label="Switch to light mode"
      title="Toggle light / dark mode"
    >
      <img
        class="lamp lamp-off"
        src="/redstone_lamp_off.png"
        width="174"
        height="152"
        alt=""
        aria-hidden="true"
        loading="eager"
      />
      <img
        class="lamp lamp-on"
        src="/redstone_lamp_on.png"
        width="152"
        height="152"
        alt=""
        aria-hidden="true"
        loading="eager"
      />
    </button>

    <!-- Jukebox: hidden licensed Spotify player + Minecraft now-playing pill -->
    <div id="jukebox-player" aria-hidden="true"></div>
    <div id="jukebox-pill" class="mc-pill" hidden>
      <span aria-hidden="true">♪</span>
      <span id="jukebox-title" role="status"></span>
      <button id="jukebox-stop" type="button" class="mc-stop" aria-label="Stop music">✕</button>
    </div>

    <script src="https://open.spotify.com/embed/iframe-api/v1" async></script>
    <script>
      const toggle = document.getElementById('contact-toggle');
      const panel = document.getElementById('contact-panel');
      const REDUCED_MOTION = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      function setContactOpen(open) {
        toggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (!panel) return;
        if (open) {
          panel.removeAttribute('hidden');
          panel.classList.remove('hidden');
          panel.classList.add('flex');
          // Let the browser paint first so the dropdown transition triggers.
          requestAnimationFrame(() => requestAnimationFrame(() => panel.classList.add('open')));
        } else {
          panel.classList.remove('open');
          window.setTimeout(() => {
            if (!isContactOpen()) {
              panel.setAttribute('hidden', '');
              panel.classList.add('hidden');
              panel.classList.remove('flex');
            }
          }, REDUCED_MOTION ? 0 : 200);
        }
      }
      function isContactOpen() {
        return toggle?.getAttribute('aria-expanded') === 'true';
      }
      toggle?.addEventListener('click', () => {
        setContactOpen(!isContactOpen());
      });
      // Hover opens only over the email button. The stay-open zone is exactly the
      // button (full email text + cross width) plus the panel — nothing else.
      // Click still works for touch/keyboard.
      const canHover = () => window.matchMedia('(hover: hover)').matches;
      let contactCloseTimer = null;
      function cancelContactClose() {
        if (contactCloseTimer) {
          window.clearTimeout(contactCloseTimer);
          contactCloseTimer = null;
        }
      }
      function scheduleContactClose() {
        cancelContactClose();
        contactCloseTimer = window.setTimeout(() => {
          setContactOpen(false);
          contactCloseTimer = null;
        }, 250);
      }
      toggle?.addEventListener('mouseenter', () => {
        if (!canHover()) return;
        cancelContactClose();
        setContactOpen(true);
      });
      toggle?.addEventListener('mouseleave', () => {
        if (canHover()) scheduleContactClose();
      });
      panel?.addEventListener('mouseenter', () => {
        if (!canHover()) return;
        cancelContactClose();
      });
      panel?.addEventListener('mouseleave', () => {
        if (canHover()) scheduleContactClose();
      });

      // Delegated so buttons inside infinitely-cloned columns keep working.
      // Each photo card cycles its own slides; captions live on the images.
      document.addEventListener('click', (e) => {
        if (!(e.target instanceof Element)) return;
        const nextBtn = e.target.closest('.about-next-btn');
        if (nextBtn) {
          const zone = nextBtn.closest('.about-photo');
          const slides = zone ? Array.from(zone.querySelectorAll('.slide-img')) : [];
          const cap = zone?.querySelector('.about-caption');
          const total = slides.length || 1;
          const i = (parseInt(nextBtn.dataset.i || '0', 10) + 1) % total;
          nextBtn.dataset.i = String(i);
          slides.forEach((img, k) => {
            if (k === i) img.removeAttribute('hidden');
            else img.setAttribute('hidden', '');
          });
          zone?.querySelectorAll('video').forEach((v) => {
            if (v.hasAttribute('hidden')) v.pause();
            else v.play().catch(() => {});
          });
          if (cap) {
            const text = slides[i]?.getAttribute('data-cap') || '[TODO caption]';
            cap.textContent = `${String(i + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')} — ${text}`;
          }
          return;
        }
        const opener = e.target.closest('.open-modal');
        if (opener) {
          const id = opener.getAttribute('data-modal');
          const dlg = document.getElementById(`modal-${id}`);
          if (dlg instanceof HTMLDialogElement) {
            dlg.dataset.openedBy = e.detail > 0 ? 'mouse' : 'keyboard';
            openDialog(dlg);
          }
        }
      });
      // Animated dialogs: slide up on open, slide back down on close.
      const DIALOG_ANIM_MS = 250;
      function openDialog(dlg) {
        dlg.classList.remove('closing');
        delete dlg.dataset.closing;
        dlg.showModal();
      }
      function closeDialog(dlg) {
        if (!(dlg instanceof HTMLDialogElement) || !dlg.open || dlg.dataset.closing) return;
        dlg.dataset.closing = '1';
        dlg.classList.add('closing');
        window.setTimeout(() => {
          dlg.classList.remove('closing');
          delete dlg.dataset.closing;
          if (dlg.open) dlg.close();
        }, REDUCED_MOTION ? 0 : DIALOG_ANIM_MS);
      }
      document.querySelectorAll('.close-modal').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-close');
          closeDialog(document.getElementById(`modal-${id}`));
        });
      });
      document.querySelectorAll('dialog').forEach((dlg) => {
        dlg.addEventListener('click', (e) => {
          if (e.target === dlg) closeDialog(dlg);
        });
        dlg.addEventListener('cancel', (e) => {
          // Animate Escape dismissals instead of closing instantly.
          e.preventDefault();
          closeDialog(dlg);
        });
        dlg.addEventListener('close', () => {
          // Browsers restore focus to the opener when a dialog closes (e.g. via
          // Escape), leaving a sticky ring for mouse users. Release it only when
          // the dialog was opened with the mouse; keyboard focus is preserved.
          if (dlg.dataset.openedBy === 'mouse' && document.activeElement instanceof HTMLElement) {
            document.activeElement.blur();
          }
          delete dlg.dataset.openedBy;
        });
      });

      // No sticky focus rings anywhere for mouse users (real clicks have
      // detail > 0; keyboard clicks have detail === 0 and keep their ring).
      document.addEventListener('click', (e) => {
        const btn = e.target instanceof Element ? e.target.closest('button') : null;
        if (btn && e.detail > 0) btn.blur();
      });

      // Jukebox: one background track at a time via the official Spotify IFrame API.
      const discBtns = Array.from(document.querySelectorAll('.disc-btn'));
      const pill = document.getElementById('jukebox-pill');
      const pillTitle = document.getElementById('jukebox-title');
      const playerHost = document.getElementById('jukebox-player');
      let spotifyController = null;
      let spotifyReady = false;
      let pendingTrack = null;
      let currentTrackId = null;

      function showPill(title) {
        if (pillTitle) pillTitle.textContent = `♪ ${title}`;
        pill?.removeAttribute('hidden');
      }
      function showPillFallback(id, title) {
        if (!pillTitle) return;
        pillTitle.textContent = '';
        const link = document.createElement('a');
        link.href = `https://open.spotify.com/track/${id}`;
        link.target = '_blank';
        link.rel = 'noopener';
        link.textContent = `♪ ${title} — open in Spotify`;
        link.className = 'text-fg underline';
        pillTitle.appendChild(link);
        pill?.removeAttribute('hidden');
      }
      function hidePill() {
        pill?.setAttribute('hidden', '');
      }
      function markPressed(id) {
        discBtns.forEach((b) => {
          b.setAttribute('aria-pressed', b.getAttribute('data-track') === id ? 'true' : 'false');
        });
      }
      function playTrack(id, title) {
        currentTrackId = id;
        markPressed(id);
        if (spotifyReady && spotifyController) {
          spotifyController.loadUri(`spotify:track:${id}`);
          spotifyController.play();
          showPill(title);
        } else {
          pendingTrack = { id, title };
          showPill(`${title} — loading…`);
          window.setTimeout(() => {
            if (pendingTrack && !spotifyReady) {
              showPillFallback(pendingTrack.id, pendingTrack.title);
              pendingTrack = null;
            }
          }, 8000);
        }
      }
      function stopPlayback() {
        try {
          if (spotifyController) spotifyController.pause();
        } catch {
          /* player unavailable — just hide UI */
        }
        currentTrackId = null;
        pendingTrack = null;
        markPressed('');
        hidePill();
      }

      window.onSpotifyIframeApiReady = (IFrameAPI) => {
        const mount = document.createElement('div');
        playerHost?.appendChild(mount);
        IFrameAPI.createController(
          mount,
          { width: '2', height: '2', uri: 'spotify:track:7z3rdMzhY122waIpkSsE7P' },
          (controller) => {
            spotifyController = controller;
            spotifyReady = true;
            window.__jukeboxApiReady = true;
            if (pendingTrack) {
              controller.loadUri(`spotify:track:${pendingTrack.id}`);
              controller.play();
              showPill(pendingTrack.title);
              pendingTrack = null;
            }
          }
        );
      };

      discBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-track') || '';
          const title = btn.getAttribute('data-title') || 'Unknown track';
          if (currentTrackId === id) stopPlayback();
          else playTrack(id, title);
        });
      });
      document.getElementById('jukebox-stop')?.addEventListener('click', stopPlayback);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && currentTrackId && !document.querySelector('dialog[open]')) {
          stopPlayback();
        }
      });

      // Theme lamp: dark by default, light swaps netherite <-> iron blocks.
      const themeBtn = document.getElementById('theme-toggle');
      function setTheme(mode) {
        const light = mode === 'light';
        document.documentElement.dataset.theme = light ? 'light' : 'dark';
        try {
          localStorage.setItem('pedrolibdev-theme', light ? 'light' : 'dark');
        } catch {
          /* private mode — theme just won't persist */
        }
        themeBtn?.setAttribute('aria-pressed', String(light));
        themeBtn?.setAttribute('aria-label', light ? 'Switch to dark mode' : 'Switch to light mode');
      }
      themeBtn?.addEventListener('click', () => {
        setTheme(document.documentElement.dataset.theme === 'light' ? 'dark' : 'light');
      });
      setTheme(document.documentElement.dataset.theme === 'light' ? 'light' : 'dark');

      // About photo: Next pill follows the cursor (delegated, clone-safe).
      // Scroll re-anchors it since the photo moves under a still cursor.
      let hoverPhoto = null;
      let lastCursor = null;
      function placePill(zone) {
        if (!lastCursor) return;
        const r = zone.getBoundingClientRect();
        zone.style.setProperty('--mx', `${lastCursor.x - r.left}px`);
        zone.style.setProperty('--my', `${lastCursor.y - r.top}px`);
      }
      document.addEventListener('pointermove', (e) => {
        if (!(e.target instanceof Element)) return;
        lastCursor = { x: e.clientX, y: e.clientY };
        const zone = e.target.closest('.about-photo');
        if (zone) {
          placePill(zone);
          if (hoverPhoto !== zone) {
            if (hoverPhoto instanceof HTMLElement) hoverPhoto.classList.remove('is-hover');
            zone.classList.add('is-hover');
            hoverPhoto = zone;
          }
        } else if (hoverPhoto instanceof HTMLElement) {
          hoverPhoto.classList.remove('is-hover');
          hoverPhoto = null;
        }
      });
      window.addEventListener(
        'scroll',
        () => {
          if (hoverPhoto instanceof HTMLElement) placePill(hoverPhoto);
        },
        { passive: true, capture: true }
      );

      // No autoplayed demo videos for reduced-motion users.
      if (REDUCED_MOTION) {
        document.querySelectorAll('video[autoplay]').forEach((v) => {
          v.removeAttribute('autoplay');
          v.pause();
        });
      }

      // Infinite columns. Cloned ids are stripped (modals live once, outside the
      // clones) and all buttons work through the delegated listeners above.
      // Desktop: scroll-linked loop. Each column slides at a speed proportional to
      // its own length and every column wraps at the same scroll point, so the
      // repetition always stays in sync (more cards = faster, fewer = slower).
      // Reduced-motion desktop / Mobile (single column): whole sets repeat to
      // preserve About→Projects→Playground order.
      function stripIds(root) {
        root.querySelectorAll('[id]').forEach((el) => {
          el.removeAttribute('id');
        });
      }
      if ('IntersectionObserver' in window) {
        const isDesktop = window.matchMedia('(min-width: 768px)').matches;
        if (isDesktop && !REDUCED_MOTION) {
          const columnsMain = document.getElementById('main');
          const CLONE_MARGIN = 900;
          const columns = [];
          let mainTop = 0;
          let maxPeriod = 1;
          let frame = 0;

          function cloneSection(col) {
            const clone = col.template.cloneNode(true);
            clone.removeAttribute('id');
            stripIds(clone);
            col.sentinel.before(clone);
          }

          function measure() {
            mainTop = columnsMain.getBoundingClientRect().top + window.scrollY;
            maxPeriod = 1;
            columns.forEach((col) => {
              const sections = col.el.querySelectorAll(':scope > section');
              col.period =
                sections.length > 1
                  ? sections[1].offsetTop - sections[0].offsetTop
                  : col.el.offsetHeight;
              maxPeriod = Math.max(maxPeriod, col.period);
              // Sentinel sits right after the last copy: layout bottom of content.
              col.bottom = mainTop + col.sentinel.offsetTop;
            });
          }

          function update() {
            frame = 0;
            const scrollY = window.scrollY;
            const scrollRel = Math.max(0, scrollY - mainTop);
            const viewport = window.innerHeight;
            columns.forEach((col) => {
              if (!col.period) return;
              const t = ((scrollRel * col.period) / maxPeriod) % col.period;
              col.el.style.transform = `translate3d(0, ${-t}px, 0)`;
              while (col.bottom < scrollY + t + viewport + CLONE_MARGIN) {
                cloneSection(col);
                col.bottom += col.period;
              }
            });
          }

          function schedule() {
            if (!frame) frame = window.requestAnimationFrame(update);
          }

          if (columnsMain) {
            document.querySelectorAll('.col-stack').forEach((col) => {
              const template = col.querySelector('section');
              if (!template) return;
              const sentinel = document.createElement('div');
              sentinel.setAttribute('aria-hidden', 'true');
              col.appendChild(sentinel);
              const state = { el: col, template, sentinel, period: 0, bottom: 0 };
              columns.push(state);
              cloneSection(state);
            });
            measure();
            update();
            const remeasure = () => {
              measure();
              update();
            };
            window.addEventListener('scroll', schedule, { passive: true });
            window.addEventListener('resize', remeasure);
            window.addEventListener('load', remeasure);
            // Monocraft swaps in after first paint and changes text heights.
            if (document.fonts && document.fonts.ready) document.fonts.ready.then(remeasure);
          }
        } else if (isDesktop) {
          // Reduced motion: keep the plain per-column repeat, no parallax.
          document.querySelectorAll('.col-stack').forEach((col) => {
            const template = col.querySelector('section');
            if (!template) return;
            const sentinel = document.createElement('div');
            sentinel.setAttribute('aria-hidden', 'true');
            col.appendChild(sentinel);
            new IntersectionObserver(
              (entries) => {
                if (!entries[0].isIntersecting) return;
                const clone = template.cloneNode(true);
                clone.removeAttribute('id');
                stripIds(clone);
                sentinel.before(clone);
              },
              { rootMargin: '900px 0px' }
            ).observe(sentinel);
          });
        } else {
          const columnsMain = document.getElementById('main');
          if (columnsMain) {
            const sentinel = document.createElement('div');
            sentinel.id = 'infinite-sentinel';
            sentinel.setAttribute('aria-hidden', 'true');
            columnsMain.after(sentinel);
            const infiniteObserver = new IntersectionObserver(
              (entries) => {
                if (!entries[0].isIntersecting) return;
                const clone = columnsMain.cloneNode(true);
                clone.removeAttribute('id');
                stripIds(clone);
                sentinel.before(clone);
              },
              { rootMargin: '900px 0px' }
            );
            infiniteObserver.observe(sentinel);
          }
        }
      }
    </script>
  </body>
</html>
